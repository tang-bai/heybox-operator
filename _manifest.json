{
  "manifest_version": 2,
  "id": "github.tang-bai.heybox-operator",
  "version": "0.14.0",
  "name": "小黑盒运营",
  "description": "MaiBot 小黑盒社区运营插件：扫码/Cookie 登录、人设逛帖点赞评论、私信自动回复、浏览总结发帖与 WebUI 仪表盘。",
  "author": {
    "name": "tang-bai",
    "url": "https://github.com/tang-bai"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/tang-bai/heybox-operator",
    "homepage": "https://github.com/tang-bai/heybox-operator",
    "documentation": "https://github.com/tang-bai/heybox-operator/blob/main/README.md",
    "issues": "https://github.com/tang-bai/heybox-operator/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "api.call",
    "config.get",
    "llm.generate",
    "chat.open_session",
    "maisaka.reply.generate"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "package",
      "background": "#f1f2f4"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "integration"
}
